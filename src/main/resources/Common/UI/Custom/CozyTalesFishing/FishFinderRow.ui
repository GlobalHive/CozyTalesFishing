$C = "../Common.ui";

Group #Row {
  LayoutMode: Left;
  Anchor: (Bottom: 4);
  Padding: (Full: 6);
  Background: PatchStyle(TexturePath: "../Common/Dropdown.png", Border: 16);

  Group #IconFrame {
    Anchor: (Width: 40, Height: 40);
    Padding: (Full: 2);

    AssetImage #Icon {
      Anchor: (Full: 0);
    }
  }

  Group #Info {
    LayoutMode: Top;
    FlexWeight: 1;
    Padding: (Horizontal: 10, Vertical: 2);

    Label #Name {
      Style: (RenderBold: true, FontSize: 14, TextColor: #e8eef2, Wrap: true);
    }

    Label #Rarity {
      Style: (FontSize: 12, TextColor: #9eb0bc);
    }
  }
}
